set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR arm)

set(CMAKE_C_COMPILER arm-linux-gnueabihf-gcc CACHE FILEPATH
    "Path to the target ARM hard-float C compiler")
set(CMAKE_CXX_COMPILER arm-linux-gnueabihf-g++ CACHE FILEPATH
    "Path to the target ARM hard-float C++ compiler")

if(DEFINED POCKET_SYSROOT AND NOT POCKET_SYSROOT STREQUAL "")
    set(CMAKE_SYSROOT "${POCKET_SYSROOT}")
    set(CMAKE_FIND_ROOT_PATH "${POCKET_SYSROOT}")
endif()

set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
